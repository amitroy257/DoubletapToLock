<?xml version="1.0" encoding="utf-8"?>
<!--
  force-lock is the ONLY policy claimed, and it is the minimum required for
  DevicePolicyManager.lockNow(). No wipe-data, no password policies, no encryption
  control, no camera disabling.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
