<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SetupBody"
            android:layout_marginTop="6dp"
            android:text="@string/setup_subtitle" />

        <!-- ── Screen Lock ───────────────────────────────────────────── -->
        <TextView
            style="@style/SetupHeading"
            android:text="@string/setup_screen_heading" />

        <TextView
            android:id="@+id/a11yStatus"
            style="@style/SetupStatus" />

        <TextView
            style="@style/SetupBody"
            android:text="@string/setup_screen_body" />

        <Button
            android:id="@+id/enableA11yButton"
            style="@style/SetupButton"
            android:text="@string/setup_enable_a11y" />

        <Button
            android:id="@+id/addScreenTileButton"
            style="@style/SetupButtonOutlined"
            android:text="@string/setup_add_screen_tile" />

        <Button
            android:id="@+id/testScreenButton"
            style="@style/SetupButtonOutlined"
            android:text="@string/setup_test_screen" />

        <!-- ── Secure Lock ───────────────────────────────────────────── -->
        <TextView
            style="@style/SetupHeading"
            android:text="@string/setup_secure_heading" />

        <TextView
            android:id="@+id/adminStatus"
            style="@style/SetupStatus" />

        <TextView
            style="@style/SetupBody"
            android:text="@string/setup_secure_body" />

        <Button
            android:id="@+id/grantAdminButton"
            style="@style/SetupButton"
            android:text="@string/setup_grant_admin" />

        <Button
            android:id="@+id/addSecureTileButton"
            style="@style/SetupButtonOutlined"
            android:text="@string/setup_add_secure_tile" />

        <Button
            android:id="@+id/testSecureButton"
            style="@style/SetupButtonOutlined"
            android:text="@string/setup_test_secure" />

        <Button
            android:id="@+id/revokeAdminButton"
            style="@style/SetupButtonOutlined"
            android:text="@string/setup_revoke_admin"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tileHint"
            style="@style/SetupBody"
            android:layout_marginTop="24dp"
            android:text="@string/setup_tile_hint"
            android:visibility="gone" />

        <TextView
            style="@style/SetupBody"
            android:layout_marginTop="24dp"
            android:text="@string/setup_footer" />

    </LinearLayout>
</ScrollView>
