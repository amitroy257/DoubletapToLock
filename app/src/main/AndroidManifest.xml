<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Android 11+ package visibility. Without this the app drawer comes back empty
      because queryIntentActivities() is filtered.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoubleTapLauncher">

        <!--
          THE HOME SCREEN.

          This activity IS the home screen. That is the whole trick: "am I on the home
          page?" becomes "is this activity resumed?", which is an exact fact the OS
          guarantees, instead of a guess about what some other launcher is drawing.

          launchMode="singleTask" matters: pressing Home while the app drawer is open
          brings this activity forward and destroys everything above it in the task, so
          the drawer closes for free and we can never be "on home" and "in the drawer"
          at the same time.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:theme="@style/Theme.DoubleTapLauncher.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The app drawer is a SEPARATE ACTIVITY, not a panel inside the home screen.
          While it is on top, HomeActivity is paused and receives no touch events at
          all, so the double-tap-to-lock gesture is physically incapable of firing here.
        -->
        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:theme="@style/Theme.DoubleTapLauncher.Drawer" />

        <!-- Setup / settings. This is what the app icon opens. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DoubleTapLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Preferred lock method: Device Admin -> DevicePolicyManager.lockNow(). -->
        <receiver
            android:name=".LockAdminReceiver"
            android:label="@string/admin_label"
            android:description="@string/admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Optional fallback lock method for people who would rather not grant Device
          Admin. This service does NOT watch events and never draws an overlay — it
          exists purely so HomeActivity can call performGlobalAction(LOCK_SCREEN).
        -->
        <service
            android:name=".LockAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
