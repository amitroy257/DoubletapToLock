# Copy to keystore.properties and fill in. That copy is gitignored — it holds
# plaintext passwords and must never be committed to a public repo.
#
# storeFile should be an ABSOLUTE path to a keystore kept OUTSIDE this repo,
# so it cannot be committed by accident.

storeFile=/Users/amit/keystores/doubletaptolock.jks
storePassword=your-keystore-password
keyAlias=doubletaptolock
keyPassword=your-key-password
